LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_HOST=http://localhost:11434
# true = the model reasons before answering (much slower: 149 s vs 3 s in our test)
OLLAMA_THINK=false

# Optional, only for the Claude milestone:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
